# --- Job board API keys (all optional; leave blank to disable the adapter) ---

# Adzuna: register free at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Remotive: no key needed (public API), adapter always available
# The Muse: free key at https://www.themuse.com/developers/api/v2/apps
THEMUSE_API_KEY=

# --- Proxy list for scraping (optional, recommended for LinkedIn) ---
# Comma-separated, format: user:pass@host:port or host:port or localhost
SCRAPER_PROXIES=

# --- Notifications (Phase 6; safe to leave blank) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
